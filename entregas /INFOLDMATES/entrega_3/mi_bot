def norm(s):
    return s.lower()

def stem(w):
    return w[:5]

def toks(s):
    return re.findall(r"[a-záéíóúüñ]+|\d+(?:[.,]\d+)*", s.lower())

def parse_num(tok):
    t = tok
    if re.fullmatch(r"\d{1,3}(\.\d{3})+(,\d+)?", t):
        t = t.replace(".", "").replace(",", ".")
    else:
        t = t.replace(",", ".")
    try:
        return float(t)
    except ValueError:
        return None

def numeros(texto):
    """Lista de valores numéricos del texto (cifras y palabras), con multiplicadores."""
    ws = re.findall(r"[a-záéíóúüñ]+|\d+(?:[.,]\d+)*", texto.lower())
    out = []
    i = 0
    while i < len(ws):
        w = ws[i]
        v = None
        if w[0].isdigit():
            v = parse_num(w)
        elif w in UNID:
            v = float(UNID[w])
        if v is not None:
            j = i + 1
            while j < len(ws) and ws[j] in MULT:
                v *= MULT[ws[j]]; j += 1
            if j > i + 1:
                i = j - 1
            out.append(v)
        i += 1
    return out

def candidatos(nums):
    c = set()
    base = set(nums)
    for n in base:
        c.add(n)
    L = sorted(base)
    for i, a in enumerate(L):
        for b in L[i:]:
            c.add(a + b); c.add(abs(a - b)); c.add(a * b)
            if b: c.add(a / b)
            if a: c.add(b / a)
        for p in (10, 20, 25, 30, 40, 50, 60, 70, 75, 80, 90, 5, 15, 12, 100, 2, 3, 4):
            c.add(a * p / 100.0)
    ext = set(c)
    for x in c:
        for k in (1000, 0.001, 10, 0.1, 100, 0.01, 60, 1/60., 12, 1/12., 24, 1/24., 7, 1/7.):
            ext.add(x * k)
    return ext

def casa(x, cands):
    for y in cands:
        if abs(x - y) <= 1e-6 * max(1.0, abs(x)) + 0.006 * (1 if abs(x) < 100 and x != int(x) else 0):
            return True
    return False

def contiene(texto, lista):
    t = " " + texto.lower() + " "
    return sum(1 for p in lista if p in t)

def stems_set(texto):
    return {stem(w) for w in toks(texto) if not w[0].isdigit() and w not in STOP and len(w) > 2}

def caps_set(texto):
    # palabras capitalizadas que no abren frase
    out = set()
    for m in re.finditer(r"(?<![.¿¡]\s)(?<!^)\b([A-ZÁÉÍÓÚÑ][a-záéíóúüñ]+)", texto):
        out.add(stem(m.group(1).lower()))
    return out

def pct_vals(texto):
    out=[]
    for m in re.finditer(r"(\d+(?:[.,]\d+)?)\s*(?:%|por ciento)", texto.lower()):
        v=parse_num(m.group(1))
        if v is not None: out.append(v)
    return out

def pct_cands(nums):
    c=set()
    L=sorted(set(nums))
    for a in L:
        for b in L:
            if b and a!=b:
                c.add(100.0*a/b); c.add(100.0*(a-b)/b); c.add(100.0*(b-a)/b)
    return c

def casa_pct(x, cands):
    return any(abs(x-y)<=0.51 for y in cands) or any(abs(x-y)<=1e-6 for y in cands)

def mejores_fuentes(o, fuentes, k=2):
    rpf=o["respaldo_por_fuente"]; spf=o["similitud_por_fuente"]
    sc=[(rpf[i]+spf[i],i) for i in range(len(fuentes)) if i<len(rpf) and i<len(spf)]
    sc.sort(reverse=True)
    return [i for _,i in sc[:k]]

def feat_oracion(o, fuentes, pregunta, frags):
    txt = o["texto"]
    rpf = o["respaldo_por_fuente"]; cpf = o["contradiccion_por_fuente"]; spf = o["similitud_por_fuente"]
    llm = o.get("llm") or {}
    ver = llm.get("veredicto") or "respaldada"
    conf = llm.get("confianza")
    conf = 0.5 if conf is None else float(conf)
    fu = llm.get("fuente")
    f = {}
    f["llm_malo"] = 0.0 if ver == "respaldada" else 1.0
    f["llm_contra"] = 1.0 if ver == "contradicha" else 0.0
    f["llm_pbad"] = (1 - conf) if ver == "respaldada" else conf
    f["llm_dudoso"] = (1 - conf) if ver == "respaldada" else 0.0
    f["nli_best"] = max(rpf, default=0.0)
    f["nli_all"] = o.get("respaldo_todas", 0.0)
    f["contr_all"] = o.get("contradiccion_todas", 0.0)
    f["contr_best"] = max(cpf, default=0.0)
    f["sim_best"] = max(spf, default=0.0)
    if fu is not None and isinstance(fu, int) and 0 <= fu < len(rpf):
        f["cit_resp"] = rpf[fu]; f["cit_contr"] = cpf[fu]
    else:
        f["cit_resp"] = f["nli_best"]; f["cit_contr"] = f["contr_best"]
    f["nli_gap"] = f["nli_all"] - f["nli_best"]
    mine = [fr for fr in frags if True]
    if mine:
        f["fr_min_all"] = min(fr["respaldo_todas"] for fr in mine)
        f["fr_min_best"] = min(max(fr["respaldo_por_fuente"], default=0) for fr in mine)
        f["fr_max_contr"] = max(max(fr["contradiccion_por_fuente"], default=0) for fr in mine)
        f["fr_max_contr_all"] = max(fr["contradiccion_todas"] for fr in mine)
        f["fr_min_cmax"] = min(max(fr["respaldo_todas"], max(fr["respaldo_por_fuente"], default=0)) for fr in mine)
    else:
        f["fr_min_all"] = f["fr_min_best"] = f["fr_min_cmax"] = f["nli_all"]
        f["fr_max_contr"] = f["fr_max_contr_all"] = f["contr_all"]
    # --- texto
    fuentes_txt = " ".join(fuentes)
    src_nums = []
    for s in fuentes: src_nums += numeros(s)
    q_nums = numeros(pregunta)
    cands = candidatos(src_nums + q_nums)
    nums = numeros(txt)
    f["n_nums"] = float(len(nums))
    f["n_num_sin"] = float(sum(1 for x in nums if not casa(x, cands)))
    # números sin respaldo ni en el conjunto directo (más estricto)
    direct = set(src_nums) | set(q_nums)
    f["n_num_nodirect"] = float(sum(1 for x in nums if x not in direct and not casa(x, direct)))
    st_ans = stems_set(txt); st_src = stems_set(fuentes_txt) | stems_set(pregunta)
    nov = st_ans - st_src
    f["n_nov"] = float(len(nov)); f["frac_nov"] = len(nov) / max(1, len(st_ans))
    cap_a = caps_set(txt); cap_s = {stem(w) for w in toks(fuentes_txt)}
    f["n_cap_nov"] = float(len(cap_a - cap_s - st_src))
    low_a = txt.lower(); low_s = fuentes_txt.lower()
    cit = fuentes[fu].lower() if (isinstance(fu, int) and 0 <= fu < len(fuentes)) else low_s
    for nombre, lex in (("causa", CAUSA), ("univ", UNIV), ("fuerte", FUERTE), ("hedge", HEDGE)):
        na = [p for p in lex if p in " " + low_a + " "]
        f[nombre + "_nuevo"] = float(sum(1 for p in na if p not in low_s))
        f[nombre + "_nocit"] = float(sum(1 for p in na if p not in cit))
    # hedges de la fuente citada cuyo número aparece sin el hedge
    perd = 0
    for h in HEDGE[:12]:
        for m in re.finditer(re.escape(h) + r"\s+(\d[\d.,]*)", cit):
            n = m.group(1)
            if n in low_a and (h + " " + n) not in low_a:
                perd += 1
    f["hedge_perdido"] = float(perd)
    # hedges de cualquier fuente con sus números
    perd2 = 0
    for h in HEDGE[:12]:
        for m in re.finditer(re.escape(h) + r"\s+(\d[\d.,]*)", low_s):
            n = m.group(1)
            if n in low_a and (h + " " + n) not in low_a:
                perd2 += 1
    f["hedge_perdido_any"] = float(perd2)
    f["neg_dif"] = float(abs(contiene(low_a, NEG) - contiene(cit, NEG)))
    f["neg_nuevo"] = float(sum(1 for p in NEG if p in " " + low_a + " " and p not in low_s))
    # --- números respecto a fuentes relevantes (derivadas solo de ellas)
    top = set(mejores_fuentes(o, fuentes, 3))
    if isinstance(fu, int) and 0 <= fu < len(fuentes): top.add(fu)
    top_nums = []
    for i in top: top_nums += numeros(fuentes[i])
    cands_top = candidatos(top_nums + q_nums)
    f["n_num_sin_top"] = float(sum(1 for x in nums if not casa(x, cands_top)))
    direct_top = set(top_nums) | set(q_nums)
    f["n_num_nodir_top"] = float(sum(1 for x in nums if x not in direct_top))
    pv = pct_vals(txt)
    pc_all = pct_cands(src_nums) | cands
    pc_top = pct_cands(top_nums) | cands_top
    f["n_pct_sin"] = float(sum(1 for x in pv if not casa_pct(x, pc_all)))
    f["n_pct_sin_top"] = float(sum(1 for x in pv if not casa_pct(x, pc_top)))
    # restrictores / modales de las fuentes relevantes que se pierden en la respuesta
    textos_top = " ".join(fuentes[i].lower() for i in top)
    la = " " + low_a + " "
    f["restr_perd"] = float(sum(1 for p in RESTR if p in " " + textos_top + " " and p not in la))
    f["restr_perd_cit"] = float(sum(1 for p in RESTR if p in " " + cit + " " and p not in la))
    f["modal_cambio"] = float(sum(1 for p in MODAL if (p in la) != (p in " " + textos_top + " ")))
    f["modal_nuevo"] = float(sum(1 for p in MODAL if p in la and p not in " " + textos_top + " "))
    # cobertura: qué parte de la fuente citada recoge la respuesta
    st_cit = stems_set(cit)
    f["cobertura_cit"] = len(st_cit & st_ans) / max(1, len(st_cit))
    f["restr_x_cob"] = f["restr_perd_cit"] * f["cobertura_cit"]
    f["len_tok"] = float(len(toks(txt)))
    return f

def sent_feats(caso):
    sen = caso["senales"]
    frs = sen["fragmentos"]
    out = []
    for i, o in enumerate(sen["oraciones"]):
        mine = [fr for fr in frs if fr.get("oracion") == i]
        out.append(feat_oracion(o, caso["fuentes"], caso["pregunta"], mine))
    return out

MAXF = ["llm_malo","llm_contra","llm_pbad","llm_dudoso","contr_all","contr_best","fr_max_contr","fr_max_contr_all",
        "n_num_sin","n_num_nodirect","n_nov","frac_nov","n_cap_nov","causa_nuevo","causa_nocit","univ_nuevo","univ_nocit",
        "fuerte_nuevo","fuerte_nocit","hedge_nuevo","hedge_nocit","hedge_perdido","hedge_perdido_any","neg_dif","neg_nuevo","cit_contr",
        "n_num_sin_top","n_num_nodir_top","n_pct_sin","n_pct_sin_top","restr_perd","restr_perd_cit","modal_cambio","modal_nuevo","restr_x_cob"]
MINF = ["nli_best","nli_all","sim_best","cit_resp","nli_gap","fr_min_all","fr_min_best","fr_min_cmax","cobertura_cit"]

def vector(caso):
    sf = sent_feats(caso)
    names, vals = [], []
    for k in MAXF:
        names.append("max_" + k); vals.append(max(s[k] for s in sf))
    for k in MINF:
        names.append("min_" + k); vals.append(min(s[k] for s in sf))
    # sentencia con peor señal combinada: LLM y NLI de esa oración
    return names, vals


