import math

def _arbol(t, x):
    f, th, l, r, v = t
    n = 0
    while l[n] != -1:
        n = l[n] if x[f[n]] <= th[n] else r[n]
    return v[n]

def prob_oracion(x):
    raw = INIT + LR * sum(_arbol(t, x) for t in TREES)
    return 1.0 / (1.0 + math.exp(-raw))

def _subcaso(caso, i):
    sen = caso["senales"]
    fr = [dict(f, oracion=0) for f in sen["fragmentos"] if f.get("oracion") == i]
    return {"pregunta": caso["pregunta"], "fuentes": caso["fuentes"], "respuesta": caso["respuesta"],
            "senales": {"oraciones": [sen["oraciones"][i]], "fragmentos": fr}}

def _reescala(p):
    # lineal a trozos: THR -> 0.5, 0 -> 0, 1 -> 1
    if p < THR:
        return 0.5 * p / THR
    return 0.5 + 0.5 * (p - THR) / (1.0 - THR)


class Guardian:
    """Puntúa CADA oración con un gradient boosting sobre señales + comprobaciones propias
    (cifras, alcance, causas, matices perdidos) y se queda con la PEOR oración: basta una afirmación sin respaldo."""

    def score(self, caso):
        n = len(caso["senales"]["oraciones"])
        if n == 0:
            return 0.5
        peor = 0.0
        for i in range(n):
            _, x = vector(_subcaso(caso, i))
            peor = max(peor, prob_oracion(x))
        return float(min(1.0, max(0.0, _reescala(peor))))
